# =========================================
# Stage: Development (Vite React.js App)
# =========================================
ARG NODE_VERSION=24.14.0-alpine

FROM node:${NODE_VERSION} AS dev

# Set working directory inside the container and hand it to the non-root
# "node" user before installing, so node_modules never needs a recursive chown
WORKDIR /app
RUN chown node:node /app

# Switch to the built-in non-root "node" user
USER node

# Copy package files
COPY --chown=node:node package.json package-lock.json ./

# Install dependencies (clean, lockfile-exact install)
RUN npm ci

# Copy rest of the source code
COPY --chown=node:node . .


# Expose Vite dev server port
EXPOSE 5173

# Run Vite in dev mode, accessible outside the container
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
